# Obrigatório: true ou false. Não realiza ações nesta etapa.
DRY_RUN=true

# Publicação exige true explícito; a inspeção nunca publica.
ALLOW_PUBLISH=false

# Segunda trava da publicação real: somente YES autoriza junto de ALLOW_PUBLISH=true.
CONFIRM_REAL_PUBLISH=NO

# Obrigatórios para smoke:story-prepare; preenchidos pela origem, sem defaults.
STORY_IMAGE=
STORY_URL=
STICKER_TEXT=
# Opcional: identidade fornecida pela origem; UUID gerado somente se ausente.
JOB_ID=

# Layout do modelo aprovado: frações do canvas, escala uniforme na caixa alvo.
TARGET_STICKER_CENTER_X=0.303
TARGET_STICKER_CENTER_Y=0.593
TARGET_STICKER_WIDTH=0.45
TARGET_STICKER_HEIGHT=0.043
STICKER_LAYOUT_TOLERANCE=0.005
# Smoke isolado de movimentação: ±4% do canvas por eixo.
STICKER_POSITION_TOLERANCE=0.04
